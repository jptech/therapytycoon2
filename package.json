{
  "name": "therapy-tycoon-v2",
  "version": "2.0.0",
  "description": "A cozy therapy-practice management sim where the product is care.",
  "homepage": "https://jptech.github.io/therapytycoon2/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jptech/therapytycoon2.git"
  },
  "bugs": {
    "url": "https://github.com/jptech/therapytycoon2/issues"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "bun --bun vitest run",
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "balance": "bun run tools/balance.ts",
    "validate": "bun run tools/validate-content.ts",
    "playtest": "bun run tools/playtest.ts",
    "replay": "bun run tools/replay.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium"
  },
  "keywords": [
    "game",
    "simulation",
    "management-sim",
    "cozy-game",
    "pixijs",
    "react",
    "typescript"
  ],
  "author": "Parker Mitchell",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
